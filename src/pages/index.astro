---
import { brands, profile } from '../data/site';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="個人ゲーム開発者「おにどら」のポートフォリオ。StudioActOneとうらどらスタジオの制作活動を紹介します。" />
    <meta name="color-scheme" content="dark" />
    <title>{profile.title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}images/avatar-placeholder.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href={base} aria-label="おにどら WORKS トップ">
          おにどら <span aria-hidden="true">/</span> <span>WORKS</span>
        </a>
      </header>

      <main id="main">
        <section class="profile" aria-labelledby="profile-name">
          <div class="profile-heading">
            <img class="avatar" src={`${base}${profile.iconPath}`} alt="おにどらの仮アイコン" width="80" height="80" />
            <div>
              <p class="eyebrow">INDEPENDENT GAME DEVELOPER</p>
              <h1 id="profile-name">{profile.name}<span class="name-reading">ONIDORA</span></h1>
            </div>
          </div>
          <p class="introduction">{profile.introduction}</p>
          {profile.xUrl ? (
            <a class="social-link" href={profile.xUrl} target="_blank" rel="noopener noreferrer">Xで活動を見る <span aria-hidden="true">↗</span></a>
          ) : (
            <p class="social-pending"><span aria-hidden="true">X</span> プロフィールリンクは準備中</p>
          )}
        </section>

        <section id="works" class="works" aria-labelledby="works-title">
          <div class="section-heading">
            <h2 id="works-title">WORKS<span>制作ブランド</span></h2>
            <p>ふたつのブランド、それぞれの世界。</p>
          </div>
          <div class="brand-grid">
            {brands.map((brand, index) => (
              <article class:list={['brand-card', brand.id]} aria-labelledby={`${brand.id}-name`}>
                <div class="brand-topline">
                  <span class="brand-number">0{index + 1}</span>
                  <span class="audience">{brand.audience}</span>
                </div>
                <p class="brand-label">{brand.label}</p>
                <h3 id={`${brand.id}-name`}>{brand.name}</h3>
                <p class="brand-description">{brand.description}</p>
                <div class="work-name"><span class="work-caption">PROJECT</span><p>{brand.work}</p></div>
                <div class="brand-footer">
                  {brand.detailPath && (
                    <a href={`${base}${brand.detailPath}`} aria-describedby={brand.id === 'uradora' ? 'adult-notice' : undefined}>{brand.name}の詳細 <span aria-hidden="true">↗</span></a>
                  )}
                  {brand.externalLink && (
                    <>
                      <a href={brand.externalLink.url} target="_blank" rel="noopener noreferrer" aria-describedby={brand.externalLink.notice ? `${brand.id}-link-notice` : undefined}>{brand.externalLink.label} <span aria-hidden="true">↗</span></a>
                      {brand.externalLink.notice && <p id={`${brand.id}-link-notice`} class="external-link-notice">{brand.externalLink.notice}</p>}
                    </>
                  )}
                  {!brand.detailPath && !brand.externalLink && (
                    <p>ブランド詳細は準備中<span aria-hidden="true">—</span></p>
                  )}
                </div>
              </article>
            ))}
          </div>
          <p id="adult-notice" class="adult-notice"><span>18+</span> うらどらスタジオは18歳以上を対象とするブランドです。このサイトには成人向けの画像・動画は掲載していません。</p>
        </section>
      </main>

      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {profile.name}</p>
        <span>おにどら | WORKS</span>
      </footer>
    </div>
  </body>
</html>
